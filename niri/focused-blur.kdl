// Managed by scripts/toggle-global-blur.py --focused.
// app-blur-state: {"zen": true, "kitty": false, "Chatgpt": true, "antigravity": true, "org.gnome.Nautilus": true, "readest": true, "dev.noctalia.dropover.drop": true}
window-rule {
    match app-id="^Chatgpt$"
    background-effect { blur true; }
}
window-rule {
    match app-id="^antigravity$"
    background-effect { blur true; }
}
window-rule {
    match app-id="^dev\\.noctalia\\.dropover\\.drop$"
    background-effect { blur true; }
}
window-rule {
    match app-id="^kitty$"
    background-effect { blur false; }
}
window-rule {
    match app-id="^org\\.gnome\\.Nautilus$"
    background-effect { blur true; }
}
window-rule {
    match app-id="^readest$"
    background-effect { blur true; }
}
window-rule {
    match app-id="^zen$"
    background-effect { blur true; }
}
